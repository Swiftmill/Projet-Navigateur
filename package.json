{
  "name": "gx-navigator",
  "version": "0.1.0",
  "private": true,
  "description": "Navigateur desktop style Opera GX construit avec Electron, React, Vite et TailwindCSS.",
  "main": "dist/main/main.js",
  "license": "MIT",
  "scripts": {
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"app/**/*.{ts,tsx}\" --max-warnings=0",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,css,md}\"",
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:main\"",
    "dev:renderer": "vite --config vite.renderer.config.ts",
    "dev:main": "cross-env NODE_ENV=development vite-node --watch app/main/main.ts",
    "build": "npm run clean && npm run build:renderer && npm run build:main && npm run build:preload",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "build:main": "tsc --project tsconfig.main.json",
    "build:preload": "tsc --project tsconfig.preload.json",
    "pack": "electron-builder --config electron-builder.yml",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "postinstall": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@electron/remote": "^2.1.2",
    "axios": "^1.6.8",
    "electron-updater": "^6.1.0",
    "express": "^4.18.3",
    "ffmpeg-static": "^5.2.0",
    "framer-motion": "^11.0.0",
    "immer": "^10.0.0",
    "lodash-es": "^4.17.21",
    "nanoid": "^4.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.1",
    "tailwind-merge": "^2.2.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.42.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.28",
    "@types/react": "^18.2.39",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.1.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^30.0.0",
    "electron-builder": "^24.6.4",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "postcss": "^8.4.35",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.5",
    "tailwindcss": "^3.4.3",
    "ts-node": "^10.9.2",
    "tslib": "^2.6.2",
    "typescript": "^5.4.2",
    "vite": "^5.1.3",
    "vite-node": "^1.2.3",
    "vitest": "^1.3.1",
    "xml2js": "^0.6.2"
  }
}
